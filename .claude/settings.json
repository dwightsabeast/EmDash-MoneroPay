{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(~/stagenet-wallets/**)",
      "Edit(~/stagenet-wallets/**)",
      "Read(~/.config/xmr-pay-dev/**)",
      "Edit(~/.config/xmr-pay-dev/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.emdash/**)",
      "Read(~/.config/emdash/**)",
      "Read(**/*.keys)",
      "Read(~/xmr-pay-devkeys/**)",
      "Edit(~/xmr-pay-devkeys/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(./docs/spec.md)",
      "Edit(./.claude/**)",
      "Edit(./scripts/with-shop-env.sh)",
      "Bash(*stagenet-wallets*)",
      "Bash(*.config/xmr-pay-dev*)",
      "Bash(*stagenet.env*)",
      "Bash(*.ssh/*)",
      "Bash(*monero-wallet-cli*)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh *)",
      "Bash(*emdash login*)",
      "Bash(*emdash-plugin login*)",
      "Bash(*emdash-plugin publish*)",
      "Bash(*emdash-plugin release*)",
      "Bash(*emdash-plugin update-package*)",
      "Bash(*emdash-plugin profile*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)"
    ]
  }
}
