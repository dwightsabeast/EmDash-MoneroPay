{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "xmr-spike",
	"publisher": "did:plc:aaaaaaaaaaaaaaaaaaaaaaaa",

	"license": "MIT",
	"author": { "name": "Wyatt Dilley" },
	"security": { "email": "security@example.invalid" },
	"description": "Throwaway phase 01 spike. Never shipped.",

	// Trust contract — what runtime APIs the plugin asks for.
	// Empty arrays mean no extra privileges beyond logging,
	// KV, and route/hook registration. Changing these between
	// releases requires a version bump because installed
	// users have consented to the old contract.
	"capabilities": [],
	"allowedHosts": [],
	// Spike Q6 only: an address pool like the spec's, to test atomic claims.
	"storage": {
		"pool": { "indexes": ["status"], "uniqueIndexes": ["addrIndex"] }
	},

	// Spike Q4 only: one secret and one plain setting, to see how each is stored.
	"admin": {
		"settingsSchema": {
			"spikeSecret": { "type": "secret", "label": "Spike secret (dummy)" },
			"spikeNote": { "type": "string", "label": "Spike note" }
		}
	}
}
